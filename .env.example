CONFIG_PATH=config.yaml
COMMAND_PREFIX=!
DATABASE_PATH=data/audit.db

MESHCORE_CHANNEL_INDEX=1
MESHCORE_SERIAL_PORT=
MESHCORE_BAUDRATE=115200

HA_BASE_URL=http://homeassistant.local:8123
HA_TOKEN=replace-with-home-assistant-long-lived-access-token
HA_VERIFY_TLS=true
HA_TIMEOUT_SECONDS=5

DEDUPLICATION_WINDOW_SECONDS=300
AUDIT_RETENTION_DAYS=30

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN_FILE=/data/telegram.bot_token
TELEGRAM_ALLOWED_PRIVATE_CHAT_ID=
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_MESHCORE_CHANNEL_INDEX=1
TELEGRAM_MAX_MESHCORE_MESSAGE_LENGTH=180
